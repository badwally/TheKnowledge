# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
uv.lock

# Editor / OS
.DS_Store
.vscode/
.idea/

# Knowledge base runtime state (regenerable / sensitive)
.knowledge/locks/
.knowledge/lint/
.knowledge/watcher.*
.knowledge/scheduler.*
.knowledge/auth.yaml

# Claude Code local settings — may contain API keys in allow-list entries
.claude/settings.local.json

# Generic secrets guard
.env
.env.*
*.secret
secrets.yaml
secrets.json
credentials.json

# Sidecar binaries (large; tracked separately if at all)
raw/**/*.pdf
raw/**/*.m4a
raw/**/*.mp3
raw/**/*.mp4
raw/**/*.wav
raw/**/*.flac
raw/**/*.ogg
raw/**/*.aac
raw/**/*.opus
raw/**/*.aiff
raw/**/*.m4b
raw/**/*.caf

# Tabular data sidecars (canonical preview lives in raw/csv/<id>.md)
raw/**/*.csv
raw/**/*.tsv
raw/**/*.docx
raw/**/*.xlsx
raw/**/*.pptx

# Image sidecars (canonical description lives in raw/image/<id>.md)
raw/**/*.png
raw/**/*.jpg
raw/**/*.jpeg
raw/**/*.gif
raw/**/*.webp
raw/**/*.tiff
raw/**/*.tif
raw/**/*.bmp
raw/**/*.heic
raw/**/*.heif

# Editor swap files
*.swp
*~
*.bak

# Office lock files (~$<name>.docx is Word's lock convention)
~$*

# Obsidian UI state — high churn, per-machine, not portable
wiki/.obsidian/workspace.json
wiki/.obsidian/graph.json
# Accidental Obsidian items (Untitled.canvas, Untitled 1.canvas, Untitled.md...)
# at the wiki/ root. Catches the spam; real canvases should live in a
# subdirectory or be renamed before committing.
wiki/Untitled*

.firecrawl/
.superpowers/

# Frontend
node_modules/
